	</Identification>
	<VersionInfo Organization="Franz Höpfinger" Version="1.2" Author="Franz Höpfinger" Date="2026-11-02" Remarks="Ticker (MyLib::sys::SystemTickSender_OPC): Lebenszeichen FU1.SYSTEM_TICK fuer das Dashboard.">
	</VersionInfo>
	<VersionInfo Organization="Franz Höpfinger" Version="1.1" Author="Franz Höpfinger" Date="2026-11-02" Remarks="in drei SubApps aufgeteilt (FU_Messwerte, FU_Kommando, FU_Sollwert), E_CYCLE entfernt">
	</VersionInfo>
	<VersionInfo Organization="Franz Höpfinger" Version="1.0" Author="Franz Höpfinger" Date="2026-11-02" Remarks="initial">
	</VersionInfo>
	<CompilerInfo packageName="FBs::FU_Demo">
		<Import declaration="FBs::FU_Demo::FU_Demo_Konstanten::FU_SYSTEM_TICK_WEB_WRITE"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="Messwerte" Type="FBs::FU_Demo::FU_Messwerte" x="0" y="0">
		</SubApp>
		<SubApp Name="Kommando" Type="FBs::FU_Demo::FU_Kommando" x="0" y="300">
		</SubApp>
