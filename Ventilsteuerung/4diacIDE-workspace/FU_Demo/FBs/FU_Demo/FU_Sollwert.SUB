	</Identification>
	<VersionInfo Organization="Franz Höpfinger" Version="1.0" Author="Franz Höpfinger" Date="2026-11-02" Remarks="aus FU_Demo_H300 herausgeloest">
	</VersionInfo>
	<CompilerInfo packageName="FBs::FU_Demo">
		<Import declaration="FBs::FU_Demo::FU_Demo_Konstanten::FU_MODBUS_SOLLWERT"/>
		<Import declaration="FBs::FU_Demo::FU_Demo_Konstanten::FU_FMAX_HZ"/>
		<Import declaration="FBs::FU_Demo::FU_Demo_Konstanten::FU_SOLLWERT_FAKTOR"/>
		<Import declaration="FBs::FU_Demo::FU_Demo_Konstanten::FU_SOLLFREQUENZ_WEB_READ"/>
	</CompilerInfo>
	<SubAppInterfaceList>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Abo_SollFrequenz" Type="iec61499::net::SUBSCRIBE_1" x="-2500" y="6700">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="ID" Value="FU_SOLLFREQUENZ_WEB_READ"/>
		</FB>
		<FB Name="Begrenzung" Type="logiBUS::signalprocessing::clamp::F_ClampReal" Comment="0 .. Fmax Hz; typisiert den OPC-UA-Knoten als Float" x="-900" y="6700">
			<Parameter Name="rMin" Value="0.0"/>
			<Parameter Name="rMax" Value="FU_FMAX_HZ"/>
		</FB>
		<FB Name="Hz_zu_Prozent" Type="iec61131::arithmetic::F_MUL" Comment="Hz * 10000 / Fmax = Registerwert 9301H (0..10000)" x="300" y="6700">
			<Parameter Name="IN2" Value="FU_SOLLWERT_FAKTOR"/>
		</FB>
		<FB Name="Sollwert_UINT" Type="iec61131::conversion::F_REAL_TO_UINT" x="1500" y="6700">
		</FB>
		<FB Name="Schreiben_Sollwert" Type="iec61499::net::CLIENT_1_0" Comment="9301H Frequenzsollwert" x="2700" y="6700">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="ID" Value="FU_MODBUS_SOLLWERT"/>
		</FB>
		<EventConnections>
			<Connection Source="Abo_SollFrequenz.IND" Destination="Begrenzung.REQ" dx1="386.67"/>
			<Connection Source="Begrenzung.CNF" Destination="Hz_zu_Prozent.REQ"/>
			<Connection Source="Hz_zu_Prozent.CNF" Destination="Sollwert_UINT.REQ"/>
			<Connection Source="Sollwert_UINT.CNF" Destination="Schreiben_Sollwert.REQ" dx1="113.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="Abo_SollFrequenz.RD_1" Destination="Begrenzung.rIn" dx1="386.67"/>
			<Connection Source="Begrenzung." Destination="Hz_zu_Prozent.IN1" dx1="180"/>
			<Connection Source="Hz_zu_Prozent.OUT" Destination="Sollwert_UINT.IN"/>
			<Connection Source="Sollwert_UINT.OUT" Destination="Schreiben_Sollwert.SD_1" dx1="113.33"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
