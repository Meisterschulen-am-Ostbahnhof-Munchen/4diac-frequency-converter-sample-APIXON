<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="FU_Sollwert" Comment="Sollfrequenz in Hz vom Web-Dashboard (OPC UA FU1.SollFrequenz) -> auf 0..Fmax begrenzen -> % von Fmax -> 9301H.">
