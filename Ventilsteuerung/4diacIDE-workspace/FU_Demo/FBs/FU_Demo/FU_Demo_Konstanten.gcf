<?xml version="1.0" encoding="UTF-8"?>
<GlobalConstants Name="FU_Demo_Konstanten" Comment="Adressen der FU-Demo: Modbus-TCP-Verbindungen (APIXON -&gt; Waveshare RS232/485/422 TO POE ETH (B) -&gt; DELIXI H300 0,75 kW) und lokale OPC-UA-Knoten fuer das Web-Dashboard. Alle Adressen, IPs und Skalierungen nur hier aendern.">
	<Identification Standard="61499-1" Description="Copyright (c) 2026 Franz Höpfinger &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Franz Höpfinger" Version="1.0" Author="Franz Höpfinger" Date="2026-11-02" Remarks="initial - ein H300 an einem Waveshare-Gateway, Register laut H300-Handbuch Kap. 9.1 / 9.2.9.">
	</VersionInfo>
	<CompilerInfo packageName="FBs::FU_Demo">
	</CompilerInfo>
	<GlobalConstants>
		<VarDeclaration Name="APIXON" Type="WSTRING" Comment="MGR_ID der APIXON (Deploy-Adresse der 4diac IDE) - einzige Stelle" InitialValue="&quot;192.168.1.11:61499&quot;"/>
		<VarDeclaration Name="FU_MODBUS_LESEN" Type="WSTRING" Comment="Zyklisches Lesen (500 ms), Adressen DEZIMAL (FORTE parst mit strtoul Basis 10!): 36864..36868 =" InitialValue="&quot;modbus[tcp:192.168.1.200:4196:1:500:h36864..36868,h36870,h37682,h37683:]&quot;"/>
		<VarDeclaration Name="FU_MODBUS_KOMMANDO" Type="WSTRING" Comment="Steuerwort 9300H = 37632 dezimal (1=Vorwaerts, 2=Rueckwaerts, 5=Freier Auslauf, 6=Rampenstopp," InitialValue="&quot;modbus[tcp:192.168.1.200:4196:1:500::h37632]&quot;"/>
		<VarDeclaration Name="FU_MODBUS_SOLLWERT" Type="WSTRING" Comment="Frequenzsollwert 9301H = 37633 dezimal, 0..10000 = 0,00..100,00 % von P0.1.16 (Maximalfrequenz)," InitialValue="&quot;modbus[tcp:192.168.1.200:4196:1:500::h37633]&quot;"/>
		<VarDeclaration Name="FU_FMAX_HZ" Type="REAL" Comment="Muss zu P0.1.16 (Maximalfrequenz) am Umrichter passen, Werksdefault 50,00 Hz" InitialValue="50.0"/>
		<VarDeclaration Name="FU_SOLLWERT_FAKTOR" Type="REAL" Comment="Hz -&gt; Registerwert 9301H: 10000 / FU_FMAX_HZ (200.0 bei 50 Hz) - bei Aenderung von FU_FMAX_HZ mit" InitialValue="REAL#200.0"/>
		<VarDeclaration Name="FU_SKALIERUNG_0_01" Type="REAL" Comment="Registerauflösung 0,01 (Frequenz in Hz, Strom in A)" InitialValue="0.01"/>
		<VarDeclaration Name="FU_SKALIERUNG_0_1" Type="REAL" Comment="Registerauflösung 0,1 (Zwischenkreisspannung in V, Leistung in kW)" InitialValue="0.1"/>
		<VarDeclaration Name="FU_SKALIERUNG_1" Type="REAL" Comment="Registerauflösung 1 (Ausgangsspannung in V)" InitialValue="1.0"/>
		<VarDeclaration Name="FU_MESSWERTE_WEB_WRITE" Type="WSTRING" Comment="PUBLISH_8 auf den lokalen OPC-UA-Server, vom Web-Dashboard abonniert. Reihenfolge = SD_1..SD_8." InitialValue="&quot;opc_ua[WRITE;/Objects/FU1/IstFrequenz,1:s=FU1.IstFrequenz;/Objects/FU1/SollFrequenzAktiv,1:s=FU1.SollFrequenzAktiv;/Objects/FU1/Strom,1:s=FU1.Strom;/Objects/FU1/Ausgangsspannung,1:s=FU1.Ausgangsspannung;/Objects/FU1/Zwischenkreisspannung,1:s=FU1.Zwischenkreisspannung;/Objects/FU1/Leistung,1:s=FU1.Leistung;/Objects/FU1/Status,1:s=FU1.Status;/Objects/FU1/Fehlercode,1:s=FU1.Fehlercode]&quot;"/>
		<VarDeclaration Name="FU_KOMMANDO_WEB_READ" Type="WSTRING" Comment="Steuerwort vom Web-Dashboard (UInt16, Werte siehe FU_MODBUS_KOMMANDO). Jeder Schreibzugriff des" InitialValue="&quot;opc_ua[READ;/Objects/FU1/Kommando,1:s=FU1.Kommando]&quot;"/>
		<VarDeclaration Name="FU_SOLLFREQUENZ_WEB_READ" Type="WSTRING" Comment="Sollfrequenz in Hz vom Web-Dashboard (Float), wird auf 0..FU_FMAX_HZ begrenzt" InitialValue="&quot;opc_ua[READ;/Objects/FU1/SollFrequenz,1:s=FU1.SollFrequenz]&quot;"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[PACKAGE FBs::FU_Demo;

GLOBALCONSTANTS FU_Demo_Konstanten
	VAR_GLOBAL CONSTANT
		APIXON : WSTRING := "192.168.1.11:61499"; // MGR_ID der APIXON (Deploy-Adresse der 4diac IDE) - einzige Stelle
		FU_MODBUS_LESEN : WSTRING := "modbus[tcp:192.168.1.200:4196:1:500:h36864..36868,h36870,h37682,h37683:]"; // Zyklisches Lesen (500 ms), Adressen DEZIMAL (FORTE parst mit strtoul Basis 10!): 36864..36868 =
		                                                                                                         // 9000H..9004H (Ist-Frequenz, Soll-Frequenz, Strom, Ausgangsspannung, Zwischenkreisspannung), 36870
		                                                                                                         // = 9006H (Leistung), 37682 = 9332H (Betriebsstatus), 37683 = 9333H (Fehlercode). Slave-ID 1 =
		                                                                                                         // P0.1.40 Werksdefault.
		FU_MODBUS_KOMMANDO : WSTRING := "modbus[tcp:192.168.1.200:4196:1:500::h37632]"; // Steuerwort 9300H = 37632 dezimal (1=Vorwaerts, 2=Rueckwaerts, 5=Freier Auslauf, 6=Rampenstopp,
		                                                                                // 7=Fehler quittieren). pollFrequency bewusst gleich wie FU_MODBUS_LESEN (500) und NICHT 0: bei 0
		                                                                                // laeuft in FORTE ein 1-ms-Leerpoll auf der gemeinsamen Verbindung, der zudem den Auto-Reconnect
		                                                                                // verhindert. REQ schreibt trotzdem sofort.
		FU_MODBUS_SOLLWERT : WSTRING := "modbus[tcp:192.168.1.200:4196:1:500::h37633]"; // Frequenzsollwert 9301H = 37633 dezimal, 0..10000 = 0,00..100,00 % von P0.1.16 (Maximalfrequenz),
		                                                                                // nur RAM, kein EEPROM-Verschleiss. pollFrequency siehe FU_MODBUS_KOMMANDO.
		FU_FMAX_HZ : REAL := 50.0; // Muss zu P0.1.16 (Maximalfrequenz) am Umrichter passen, Werksdefault 50,00 Hz
		FU_SOLLWERT_FAKTOR : REAL := REAL#200.0; // Hz -> Registerwert 9301H: 10000 / FU_FMAX_HZ (200.0 bei 50 Hz) - bei Aenderung von FU_FMAX_HZ mit
		                                         // anpassen. Typisiertes Literal REAL#, weil es an den generischen Eingang F_MUL.IN2 geht.
		FU_SKALIERUNG_0_01 : REAL := 0.01; // Registerauflösung 0,01 (Frequenz in Hz, Strom in A)
		FU_SKALIERUNG_0_1 : REAL := 0.1; // Registerauflösung 0,1 (Zwischenkreisspannung in V, Leistung in kW)
		FU_SKALIERUNG_1 : REAL := 1.0; // Registerauflösung 1 (Ausgangsspannung in V)
		FU_MESSWERTE_WEB_WRITE : WSTRING :=
			"opc_ua[WRITE;/Objects/FU1/IstFrequenz,1:s=FU1.IstFrequenz;/Objects/FU1/SollFrequenzAktiv,1:s=FU1.SollFrequenzAktiv;/Objects/FU1/Strom,1:s=FU1.Strom;/Objects/FU1/Ausgangsspannung,1:s=FU1.Ausgangsspannung;/Objects/FU1/Zwischenkreisspannung,1:s=FU1.Zwischenkreisspannung;/Objects/FU1/Leistung,1:s=FU1.Leistung;/Objects/FU1/Status,1:s=FU1.Status;/Objects/FU1/Fehlercode,1:s=FU1.Fehlercode]"; // PUBLISH_8 auf den lokalen OPC-UA-Server, vom Web-Dashboard abonniert. Reihenfolge = SD_1..SD_8.
		FU_KOMMANDO_WEB_READ : WSTRING := "opc_ua[READ;/Objects/FU1/Kommando,1:s=FU1.Kommando]"; // Steuerwort vom Web-Dashboard (UInt16, Werte siehe FU_MODBUS_KOMMANDO). Jeder Schreibzugriff des
		                                                                                         // Dashboards loest genau einen Modbus-Write aus - kein zyklisches Nachsenden.
		FU_SOLLFREQUENZ_WEB_READ : WSTRING := "opc_ua[READ;/Objects/FU1/SollFrequenz,1:s=FU1.SollFrequenz]"; // Sollfrequenz in Hz vom Web-Dashboard (Float), wird auf 0..FU_FMAX_HZ begrenzt
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
</GlobalConstants>
